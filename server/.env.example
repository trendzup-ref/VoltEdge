# Server Configuration
PORT=5000
DATABASE_URL="file:./dev.db"
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here

# Customer JWT Secret & Cookie Key
CUSTOMER_JWT_SECRET=your_customer_jwt_secret_here
COOKIE_SECRET=your_cookie_secret_here

# Staff & Admin Credentials
ADMIN_EMAIL=admin@voltedge.com
ADMIN_PASSWORD=AdminPassword@123

MANAGER_EMAIL=manager@voltedge.com
MANAGER_PASSWORD=ManagerPassword@123

INVENTORY_MANAGER_EMAIL=inventory@voltedge.com
INVENTORY_MANAGER_PASSWORD=InventoryPassword@123

SALES_STAFF_EMAIL=sales@voltedge.com
SALES_STAFF_PASSWORD=SalesPassword@123

# Customer Demo Credentials
CUSTOMER_EMAIL=customer@voltedge.com
CUSTOMER_PASSWORD=CustomerPassword@123

# Razorpay Payment Gateway (Test Mode / Live Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cash on Delivery Configuration (true/false)
COD_ENABLED=true

# Notification / Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="VOLTEDGE Electronics <no-reply@voltedge-electronics.com>"
